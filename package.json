{
  "name": "@openmodels/cli",
  "version": "0.4.0",
  "description": "CLI for the OpenModels registry",
  "bin": {
    "openmodels": "./dist/bin/openmodels.js"
  },
  "files": [
    "dist/",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "type": "module",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint \"src/**/*.ts\" --fix",
    "type-check": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "chalk": "^5.6.2",
    "cli-table3": "^0.6.5",
    "commander": "^14.0.3",
    "ora": "^9.4.0",
    "yaml": "^2.9.0"
  },
  "optionalDependencies": {
    "@openmodels/sdk": "^0.7.0",
    "@openmodels/types": "^0.7.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "eslint": "^9.27.0",
    "fast-check": "^4.8.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.6"
  },
  "keywords": [
    "openmodels",
    "cli",
    "llm",
    "ai",
    "models",
    "registry"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/openmodels/openmodels"
  }
}
